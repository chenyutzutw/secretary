<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>竹風建設 True Full Land - 高階主管特助系統</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 圖示庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: 替換為清晰度極佳且線條較細的 Noto Sans TC / Zen Kaku Gothic New -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans TC"', '"Zen Kaku Gothic New"', 'sans-serif'],
                    },
                    colors: {
                        custom: {
                            bg1: '#CCDDFF',
                            bg2: '#E8CCFF',
                            accent1: '#99BBFF',
                            accent2: '#9999FF',
                            accent3: '#5599FF',
                            text1: '#009FCC',
                            text2: '#0088A8',
                            text3: '#007799'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* 全局統一背景漸層：由 #CCDDFF 漸層變到 #E8CCFF */
        body, aside, header, main { 
            background: linear-gradient(135deg, #CCDDFF 0%, #E8CCFF 100%) !important;
            color: #005577; 
            min-height: 100vh;
            font-family: 'Noto Sans TC', 'Zen Kaku Gothic New', sans-serif;
            font-weight: 400; /* 細巧清晰 */
            letter-spacing: 0.02em;
        }
        
        /* 四大 KPI 專屬左側 Accent 區塊顏色設定 */
        .kpi-accent-1 { background-color: #9999FF !important; }
        .kpi-accent-2 { background-color: #99BBFF !important; }

        .custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #99BBFF; border-radius: 4px; }
        .canvas-container { border: 1px dashed #0088A8; border-radius: 12px; background: #ffffff; }
    </style>
</head>
<body class="font-sans antialiased flex h-screen overflow-hidden">

    <!-- 1. 左側邊欄 Navigation (無硬邊線，純漸層融合) -->
    <aside class="w-64 text-[#005577] flex flex-col justify-between shrink-0">
        <div>
            <!-- 竹風建設 Logo 區域 -->
            <div class="h-16 flex items-center px-6 gap-3">
                <div class="w-9 h-9 rounded-lg bg-[#5599FF] text-white flex items-center justify-center text-lg shadow-sm">
                    <i class="fa-solid fa-city"></i>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-sm tracking-wide text-[#004466]">竹風建設</span>
                    <span class="text-[10px] font-normal text-[#007799] tracking-widest">True Full Land</span>
                </div>
            </div>

            <!-- 主選單 -->
            <nav class="p-4 space-y-1.5">
                <button onclick="switchTab('main-home')" id="btn-main-home" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium bg-[#5599FF] text-white shadow-sm transition">
                    <i class="fa-solid fa-house w-4"></i> 主頁
                </button>
                <button onclick="switchTab('calendar')" id="btn-calendar" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium text-[#005577] hover:bg-white/40 transition">
                    <i class="fa-regular fa-calendar-days w-4"></i> 行事曆
                </button>
                <button onclick="switchTab('tasks')" id="btn-tasks" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium text-[#005577] hover:bg-white/40 transition">
                    <i class="fa-solid fa-list-check w-4"></i> 簽核與決議追蹤
                </button>
                <button onclick="switchTab('projects')" id="btn-projects" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium text-[#005577] hover:bg-white/40 transition">
                    <i class="fa-solid fa-diagram-project w-4"></i> 專案進度
                </button>
                <button onclick="switchTab('contacts')" id="btn-contacts" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium text-[#005577] hover:bg-white/40 transition">
                    <i class="fa-solid fa-address-book w-4"></i> 名片資料
                </button>
                <button onclick="switchTab('gifts')" id="btn-gifts" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium text-[#005577] hover:bg-white/40 transition">
                    <i class="fa-solid fa-gift w-4"></i> 節慶送禮規劃
                </button>
                <button onclick="switchTab('notepad')" id="btn-notepad" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-medium text-[#005577] hover:bg-white/40 transition">
                    <i class="fa-solid fa-pen-to-square w-4"></i> 記事本
                </button>
            </nav>
        </div>

        <!-- 特助名牌 -->
        <div class="p-4 flex items-center gap-3 cursor-pointer hover:bg-white/30 rounded-2xl mx-2 my-2 transition">
            <div class="relative w-10 h-10 rounded-full overflow-hidden bg-white/60 border border-[#99BBFF] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-user text-[#005577] text-sm"></i>
            </div>
            <div class="text-xs">
                <p class="font-bold text-[#004466]">Alice Chen</p>
                <p class="text-[#007799] text-[11px]">董事長秘書</p>
            </div>
        </div>
    </aside>

    <!-- 2. 主內容區域 -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        
        <!-- Header 頂部列 (簡化邊框) -->
        <header class="h-16 px-8 flex items-center justify-between shrink-0">
            <!-- 全域即時搜尋列 -->
            <div class="relative w-80">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-[#007799] text-xs"></i>
                <input type="text" id="globalSearchInput" placeholder="搜尋關鍵字..." class="w-full pl-9 pr-4 py-1.5 text-xs bg-white/70 backdrop-blur-md border border-white/50 text-[#004466] font-normal rounded-xl focus:outline-none focus:bg-white transition shadow-sm">
            </div>

            <!-- 主管狀態與時間 -->
            <div class="flex items-center gap-4">
                <div class="text-right text-xs text-[#005577]">
                    <div id="clock-date" class="font-medium">2026-09-13 (日)</div>
                    <div id="clock-time" class="text-[#007799] font-mono text-[11px]">00:58:32</div>
                </div>
                <div class="flex items-center gap-2 text-xs px-3 py-1 rounded-full font-medium bg-white/60 backdrop-blur-md shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[#005577]">行程中</span>
                </div>
            </div>
        </header>

        <!-- 動態內容區域 -->
        <main class="flex-1 p-8 overflow-y-auto custom-scrollbar">

            <!-- PAGE 1: 主頁儀表板 (Dashboard) -->
            <section id="tab-main-home" class="space-y-6">
                <!-- 四大 KPI (左側 Accent 顏色為 #9999FF 與 #99BBFF) -->
                <div class="grid grid-cols-4 gap-5">
                    <div onclick="switchTab('calendar')" class="bg-white/80 backdrop-blur-md p-4 rounded-2xl shadow-sm transition hover:shadow-md cursor-pointer flex overflow-hidden">
                        <div class="w-2 rounded-full mr-3.5 kpi-accent-1"></div>
                        <div class="flex-1 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-normal text-[#007799]">今日主管行程</p>
                                <p class="text-xl font-bold text-[#004466] mt-1" id="kpi-today-count">3 場會議</p>
                            </div>
                            <div class="w-9 h-9 rounded-xl bg-[#CCDDFF]/50 text-[#005577] flex items-center justify-center text-sm"><i class="fa-regular fa-calendar"></i></div>
                        </div>
                    </div>

                    <div onclick="switchTab('tasks')" class="bg-white/80 backdrop-blur-md p-4 rounded-2xl shadow-sm transition hover:shadow-md cursor-pointer flex overflow-hidden">
                        <div class="w-2 rounded-full mr-3.5 kpi-accent-2"></div>
                        <div class="flex-1 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-normal text-[#007799]">待追蹤簽核</p>
                                <p class="text-xl font-bold text-[#004466] mt-1" id="kpi-task-count">2 件待辦</p>
                            </div>
                            <div class="w-9 h-9 rounded-xl bg-[#CCDDFF]/50 text-[#005577] flex items-center justify-center text-sm"><i class="fa-solid fa-clock-rotate-left"></i></div>
                        </div>
                    </div>

                    <div onclick="switchTab('projects')" class="bg-white/80 backdrop-blur-md p-4 rounded-2xl shadow-sm transition hover:shadow-md cursor-pointer flex overflow-hidden">
                        <div class="w-2 rounded-full mr-3.5 kpi-accent-1"></div>
                        <div class="flex-1 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-normal text-[#007799]">進行中專案</p>
                                <p class="text-xl font-bold text-[#004466] mt-1" id="kpi-project-count">3 項專案</p>
                            </div>
                            <div class="w-9 h-9 rounded-xl bg-[#CCDDFF]/50 text-[#005577] flex items-center justify-center text-sm"><i class="fa-solid fa-diagram-project"></i></div>
                        </div>
                    </div>

                    <div onclick="switchTab('gifts')" class="bg-white/80 backdrop-blur-md p-4 rounded-2xl shadow-sm transition hover:shadow-md cursor-pointer flex overflow-hidden">
                        <div class="w-2 rounded-full mr-3.5 kpi-accent-2"></div>
                        <div class="flex-1 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-normal text-[#007799]">送禮規劃進度</p>
                                <p class="text-xl font-bold text-[#004466] mt-1">100% 已紀錄</p>
                            </div>
                            <div class="w-9 h-9 rounded-xl bg-[#CCDDFF]/50 text-[#005577] flex items-center justify-center text-sm"><i class="fa-solid fa-gift"></i></div>
                        </div>
                    </div>
                </div>

                <!-- 公告與操作 -->
                <div class="grid grid-cols-3 gap-6">
                    <div class="col-span-2 bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-4">
                        <h3 class="font-bold text-base text-[#004466] flex items-center gap-2">
                            <i class="fa-solid fa-bullhorn text-[#5599FF]"></i> 重要公告與行政焦點
                        </h3>
                        <div class="space-y-3 text-xs text-[#005577]">
                            <div class="p-3.5 bg-white/60 rounded-xl border border-white">
                                <span class="bg-[#5599FF] text-white px-2 py-0.5 rounded text-[10px] font-medium">重大工程</span>
                                <p class="text-sm font-bold text-[#004466] mt-1">竹北「竹風樹海」二期建案動土典禮預備會議</p>
                                <p class="text-[#007799] mt-0.5">請特助確認建築師團隊與縣府官員出席名單。</p>
                            </div>
                            <div class="p-3.5 bg-white/60 rounded-xl border border-white">
                                <span class="bg-[#9999FF] text-white px-2 py-0.5 rounded text-[10px] font-medium">董事會通知</span>
                                <p class="text-sm font-bold text-[#004466] mt-1">Q3 經營績效審查會呈報資料簽核</p>
                                <p class="text-[#007799] mt-0.5">請於本週五前完成財務部與研發部之報告彙整。</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-3">
                        <h3 class="font-bold text-base text-[#004466]">快捷操作</h3>
                        <button onclick="openScheduleModal()" class="w-full py-2.5 bg-[#5599FF] text-white rounded-xl text-xs font-medium hover:bg-[#4488EE] transition shadow-sm">+ 新增主管行程</button>
                        <button onclick="openTaskModal()" class="w-full py-2.5 bg-[#9999FF] text-white rounded-xl text-xs font-medium hover:bg-[#8888EE] transition shadow-sm">+ 呈送簽核任務</button>
                        <button onclick="openContactModal()" class="w-full py-2.5 bg-white text-[#005577] border border-[#99BBFF] rounded-xl text-xs font-medium hover:bg-white/80 transition shadow-sm">+ 新增 VIP 名片</button>
                    </div>
                </div>
            </section>

            <!-- PAGE 2: 行事曆 -->
            <section id="tab-calendar" class="hidden space-y-6">
                <div class="flex flex-col gap-6">
                    <!-- 上方月曆 -->
                    <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-4">
                        <div class="flex items-center justify-between pb-2">
                            <button onclick="changeMonth(-1)" class="p-1 text-[#005577] hover:text-[#5599FF]"><i class="fa-solid fa-chevron-left"></i></button>
                            <h3 class="font-bold text-base text-[#004466]" id="calendar-month-year-display">2026 年 09 月</h3>
                            <button onclick="changeMonth(1)" class="p-1 text-[#005577] hover:text-[#5599FF]"><i class="fa-solid fa-chevron-right"></i></button>
                        </div>
                        <div class="grid grid-cols-7 gap-2 text-center text-xs text-[#007799] font-medium">
                            <div>日</div><div>一</div><div>二</div><div>三</div><div>四</div><div>五</div><div>六</div>
                        </div>
                        <div class="grid grid-cols-7 gap-2 text-center text-xs" id="calendar-days-grid"></div>
                        <div class="flex justify-end pt-2">
                            <button onclick="openScheduleModal()" class="px-5 py-2 bg-[#5599FF] text-white rounded-xl text-xs font-medium hover:bg-[#4488EE] transition shadow-sm">+ 排定新行程</button>
                        </div>
                    </div>

                    <!-- 下方詳細行程列表 (可點擊檢視、右側有編輯與刪除) -->
                    <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-4">
                        <div class="flex items-center justify-between pb-2">
                            <h3 class="font-bold text-base text-[#004466] flex items-center gap-2">
                                <i class="fa-solid fa-calendar-day text-[#5599FF]"></i> 詳細行程列表
                            </h3>
                            <span class="text-xs bg-[#99BBFF]/40 text-[#004466] font-medium px-3 py-1 rounded-full" id="selected-date-badge">2026-09-13</span>
                        </div>
                        <div class="space-y-3" id="selected-day-schedule-list"></div>
                    </div>
                </div>
            </section>

            <!-- PAGE 3: 簽核與決議追蹤 -->
            <section id="tab-tasks" class="hidden space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-[#004466]">簽核與決議追蹤</h2>
                    <button onclick="openTaskModal()" class="px-4 py-2 bg-[#5599FF] text-white text-xs font-medium rounded-xl shadow-sm hover:bg-[#4488EE] transition">+ 新增簽核任務</button>
                </div>

                <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="text-[#007799] border-b border-[#99BBFF]/40">
                                <th class="pb-3 font-medium">專案名稱 (點擊查看)</th>
                                <th class="pb-3 font-medium">分類</th>
                                <th class="pb-3 font-medium">呈送單位</th>
                                <th class="pb-3 font-medium">負責人</th>
                                <th class="pb-3 font-medium">截止日</th>
                                <th class="pb-3 font-medium">簽核狀態</th>
                                <th class="pb-3 font-medium text-right">操作</th>
                            </tr>
                        </thead>
                        <tbody id="task-table-body" class="divide-y divide-white/60 text-[#005577]"></tbody>
                    </table>
                </div>
            </section>

            <!-- PAGE 4: 專案進度 (3個範本，可查看，右側編輯/刪除) -->
            <section id="tab-projects" class="hidden space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-[#004466]">專案進度控管</h2>
                    <button onclick="openProjectModal()" class="px-4 py-2 bg-[#5599FF] text-white text-xs font-medium rounded-xl shadow-sm hover:bg-[#4488EE] transition">+ 新增專案</button>
                </div>

                <div class="grid grid-cols-3 gap-6" id="projects-container"></div>
            </section>

            <!-- PAGE 5: 名片資料 (5個範例，可編輯，已去除排序標語) -->
            <section id="tab-contacts" class="hidden space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-[#004466]">名片資料</h2>
                    <button onclick="openContactModal()" class="px-4 py-2 bg-[#5599FF] text-white text-xs font-medium rounded-xl shadow-sm hover:bg-[#4488EE] transition">+ 新增名片</button>
                </div>

                <div class="bg-white/70 backdrop-blur-md p-4 rounded-2xl shadow-sm">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-[#007799] text-xs"></i>
                        <input type="text" id="contactSearch" oninput="renderContacts()" placeholder="搜尋姓名、公司、職稱..." class="w-full pl-9 pr-4 py-2 text-xs bg-white/80 border border-white/50 text-[#004466] rounded-xl focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-6" id="contacts-container"></div>
            </section>

            <!-- PAGE 6: 節慶送禮規劃 -->
            <section id="tab-gifts" class="hidden space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-[#004466]">節慶送禮規劃</h2>
                    <button onclick="openGiftModal()" class="px-4 py-2 bg-[#9999FF] text-white text-xs font-medium rounded-xl shadow-sm hover:bg-[#8888EE] transition">+ 新增送禮紀錄</button>
                </div>

                <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="text-[#007799] border-b border-[#99BBFF]/40">
                                <th class="pb-3 font-medium">節慶分類</th>
                                <th class="pb-3 font-medium">對象姓名</th>
                                <th class="pb-3 font-medium">禮品內容</th>
                                <th class="pb-3 font-medium">金額</th>
                                <th class="pb-3 font-medium">日期</th>
                                <th class="pb-3 font-medium">狀態</th>
                                <th class="pb-3 font-medium">備註/謝卡</th>
                                <th class="pb-3 font-medium text-right">操作</th>
                            </tr>
                        </thead>
                        <tbody id="gift-table-body" class="divide-y divide-white/60 text-[#005577]"></tbody>
                    </table>
                </div>
            </section>

            <!-- PAGE 7: 記事本 (空白編輯器，下方有儲存備忘錄範本，可編輯刪除) -->
            <section id="tab-notepad" class="hidden space-y-6">
                <!-- 上方：空白編輯器 -->
                <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-3">
                    <div class="flex justify-between items-center pb-2 border-b border-white">
                        <h3 class="font-bold text-base text-[#004466]"><i class="fa-solid fa-file-pen text-[#5599FF] mr-2"></i>隨手記事與備忘錄</h3>
                        <button onclick="saveCurrentNote()" class="px-4 py-1.5 bg-[#5599FF] text-white text-xs font-medium rounded-xl hover:bg-[#4488EE] transition shadow-sm">儲存備忘錄</button>
                    </div>

                    <div class="flex items-center gap-2 bg-white/50 p-2 rounded-xl text-xs">
                        <button onclick="execCmd('bold')" class="px-2.5 py-1 bg-white rounded shadow-sm hover:bg-slate-50 font-bold">B</button>
                        <button onclick="execCmd('underline')" class="px-2.5 py-1 bg-white rounded shadow-sm hover:bg-slate-50 underline">U</button>
                        <button onclick="execCmd('italic')" class="px-2.5 py-1 bg-white rounded shadow-sm hover:bg-slate-50 italic">I</button>
                        <span class="text-slate-300">|</span>
                        <input type="color" onchange="execCmd('foreColor', this.value)" class="w-6 h-6 border-0 rounded cursor-pointer bg-transparent">
                    </div>

                    <!-- 空白富文本區域 -->
                    <div id="rich-editor" contenteditable="true" class="w-full h-36 p-3 bg-white/80 rounded-xl text-xs text-[#004466] focus:outline-none overflow-y-auto"></div>
                </div>

                <!-- 下方：已儲存備忘錄列表範本 (可編輯/可刪除) -->
                <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-4">
                    <h3 class="font-bold text-base text-[#004466]">已儲存的備忘錄範本</h3>
                    <div id="notes-list-container" class="grid grid-cols-2 gap-4"></div>
                </div>

                <!-- 手繪板 -->
                <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-sm space-y-3">
                    <div class="flex justify-between items-center pb-2 border-b border-white">
                        <h3 class="font-bold text-base text-[#004466]"><i class="fa-solid fa-palette text-[#9999FF] mr-2"></i>手繪與簽名板</h3>
                        <button onclick="clearCanvas()" class="px-3 py-1 bg-rose-400 text-white text-xs font-medium rounded-xl hover:bg-rose-500 transition shadow-sm">清空</button>
                    </div>
                    <div class="canvas-container overflow-hidden">
                        <canvas id="drawingCanvas" width="900" height="200" class="cursor-crosshair w-full bg-white/90"></canvas>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- 全局彈窗 MODALS -->
    <!-- 通用詳細/編輯檢視 Modal -->
    <div id="modal-detail-view" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm hidden items-center justify-center z-50">
        <div class="bg-white/95 rounded-2xl p-6 w-[550px] shadow-2xl space-y-4 max-h-[85vh] overflow-y-auto custom-scrollbar border border-white">
